# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 git에 올라가지 않습니다.

# 두뇌: gemini(무료, 기본) 또는 claude(유료)
JARVIS_PROVIDER=gemini

# 무료 Gemini 키: https://aistudio.google.com/apikey → Create API key (카드 등록 필요 없음)
GEMINI_API_KEY=

# Claude를 쓸 때만: https://console.anthropic.com
ANTHROPIC_API_KEY=

# 비워두면 제공자별 기본값 (gemini-3.5-flash-lite / claude-haiku-5-5)
# Gemini 3.8 Flash는 더 똑똑하지만 무료 한도가 하루 약 20회라 비서용으로는 빠듯함
JARVIS_MODEL=

# Whisper 모델 파일 (프로젝트 폴더 기준 경로)
WHISPER_MODEL=models/ggml-small.bin
WHISPER_LANG=ko

# 자비스가 실행할 수 있는 프로그램 목록
JARVIS_APPS=apps.json
