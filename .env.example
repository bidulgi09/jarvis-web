# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 git에 올라가지 않습니다.

# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=

# 자비스 두뇌 모델 (빠른 대답: claude-haiku-5-5 / 더 똑똑하게: claude-sonnet-5-5)
JARVIS_MODEL=claude-haiku-5-5

# Whisper 모델 파일 (프로젝트 폴더 기준 경로)
WHISPER_MODEL=models/ggml-small.bin
WHISPER_LANG=ko

# 자비스가 실행할 수 있는 프로그램 목록
JARVIS_APPS=apps.json
