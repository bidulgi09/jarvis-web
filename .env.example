# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 git에 올라가지 않습니다.

# 두뇌: groq(무료, 기본) / gemini(무료, 계정에 따라 막힐 수 있음) / claude(유료)
JARVIS_PROVIDER=groq

# 무료 Groq 키: https://console.groq.com/keys (GitHub나 Google로 로그인, 카드 필요 없음)
GROQ_API_KEY=

# Gemini를 쓸 때만: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Claude를 쓸 때만: https://console.anthropic.com
ANTHROPIC_API_KEY=

# 비워두면 제공자별 기본값 (openai/gpt-oss-120b / gemini-3.5-flash-lite / claude-haiku-5-5)
# Groq 다른 무료 모델: llama-3.3-70b-versatile, openai/gpt-oss-20b(하루 한도가 더 큼)
JARVIS_MODEL=

# Whisper 모델 파일 (프로젝트 폴더 기준 경로)
WHISPER_MODEL=models/ggml-small.bin
WHISPER_LANG=ko

# 자비스가 실행할 수 있는 프로그램 목록
JARVIS_APPS=apps.json
