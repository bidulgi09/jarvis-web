# 로컬 실행용 비밀 값 (이 파일을 .dev.vars로 복사해서 채우기 · .dev.vars는 git에 올라가지 않음)
GROQ_API_KEY=gsk_여기에_새_키
# 로그인할 때 쓸 비밀 문구 (12자 이상, 남이 못 맞힐 문장)
JARVIS_PASSPHRASE=
# 토큰 서명용 무작위 값 (32자 이상) · 만들기: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
TOKEN_SECRET=
# 이 서버를 쓸 수 있는 웹 주소 (쉼표로 여러 개)
ALLOWED_ORIGINS=https://bidulgi09.github.io,http://127.0.0.1:5500,http://localhost:5500
